# Copy this file to ".env" and fill in what you need.
#   cp .env.example .env
#
# NONE OF THIS IS REQUIRED to get a correct, cited answer. Retrieval is plain
# keyword search (no model to download), and every agent verdict + confidence
# score is plain code — none of that calls an API. This section only affects
# the OPTIONAL narrative polish layer: prose fact extraction, drawing/P&ID
# reading, and the final answer's written paragraph. Leave it all blank and
# the product still works — see "Runs fully offline" in README.md.

# ---- The "brain" (one-setting switch): gemini  OR  ollama ----
# For a fully air-gapped deployment (no outbound network at all), set
# LLM_PROVIDER=ollama and pull models locally first:
#   ollama pull qwen2.5:7b        (text)
#   ollama pull qwen2.5vl:7b      (vision, for P&ID reading)
# No code change needed — the provider switch handles it.
LLM_PROVIDER=gemini

# If using Gemini's free tier (get a key at https://aistudio.google.com/apikey):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# If using fully-offline Ollama instead (set LLM_PROVIDER=ollama):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# ---- Neo4j (connections store) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# ---- Postgres (app state + readings) ----
POSTGRES_DSN=postgresql://brain:brain@localhost:5432/brain

# ---- MinIO (raw document storage) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=corpus

# ---- Ontology profile (swap this file to change industry) ----
ONTOLOGY_PROFILE=config/ontology/oil_and_gas.yaml
