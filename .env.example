# Copy this file to ".env" and fill in what you need.
#   cp .env.example .env
#
# NONE OF THIS IS REQUIRED to get a correct, cited answer. Retrieval (local
# hybrid search below), every agent verdict, and confidence scoring never call
# an API. This section only affects the OPTIONAL narrative polish layer:
# prose fact extraction, drawing/P&ID reading, and the final answer's prose.
# Leave it all blank and the product still works — see the "Runs fully
# offline" section in README.md.

# ---- The "brain" (one-setting switch): gemini  OR  ollama ----
# For a fully air-gapped deployment (no outbound network at all), set
# LLM_PROVIDER=ollama and pull models locally first:
#   ollama pull qwen2.5:7b        (text)
#   ollama pull qwen2.5vl:7b      (vision, for P&ID reading)
# No code change needed — the provider switch handles it.
LLM_PROVIDER=gemini

# If using Gemini's free tier (get a key at https://aistudio.google.com/apikey):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# If using fully-offline Ollama instead (set LLM_PROVIDER=ollama):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# ---- Local embeddings + reranker — THIS is what powers retrieval quality. ----
# Always local, always free, loaded automatically by `make api` / `python run.py`.
# First run downloads these small open models (one time); after that, and once
# `make embed` has cached passage vectors, everything here is zero-network.
EMBED_MODEL=BAAI/bge-base-en-v1.5
EMBED_DIM=768
RERANKER_MODEL=BAAI/bge-reranker-base

# ---- Neo4j (connections store) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# ---- Postgres (app state + readings) ----
POSTGRES_DSN=postgresql://brain:brain@localhost:5432/brain

# ---- MinIO (raw document storage) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=corpus

# ---- Ontology profile (swap this file to change industry) ----
ONTOLOGY_PROFILE=config/ontology/oil_and_gas.yaml
