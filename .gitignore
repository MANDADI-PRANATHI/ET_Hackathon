.env
__pycache__/
*.pyc
.venv/
venv/
.DS_Store

# generated extraction output (large, machine-made)
data/staging/

# generated graph artefacts (merged export for the viz)
data/graph/

# generated operating readings (replayed time-series for the demo)
data/readings/

# generated evaluation / scorecard output
eval/results/

# Python caches / tooling
.pytest_cache/
.ruff_cache/
*.egg-info/

# keep the corpus folder structure + docs, but not the generated/user-added
# data files — EXCEPT the real, publicly-cited reference documents, which are
# curated project content, not machine-generated corpus data.
data/corpus/**
!data/corpus/**/
!data/corpus/SOURCES.md
!data/corpus/**/.gitkeep
!data/corpus/incidents/EXTERNAL_*.txt
!data/corpus/regulations/OSHA_*.txt
